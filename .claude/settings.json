            "command": "~/.claude/hooks/git-guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code is requesting permission\" with title \"Claude Code\" subtitle \"Waiting for confirmation\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Task completed\" with title \"Claude Code\" subtitle \"Processing completed\" sound name \"Hero\"'"
          }
        ]
      }
    ]
  },
